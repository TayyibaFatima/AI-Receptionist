# --- Groq (get a free key at https://console.groq.com/keys) ---
GROQ_API_KEY=your_groq_api_key
# Any Groq model that supports tool calling. Check https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile

# --- PostgreSQL ---
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/ai_receptionist
# Separate database used ONLY by the automated tests (name must end with _test)
TEST_DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/ai_receptionist_test

# --- Clinic ---
CLINIC_NAME=Luméra Aesthetics
CLINIC_TIMEZONE=Asia/Karachi

# --- CORS: comma-separated list of allowed frontend URLs ---
FRONTEND_URL=http://localhost:5173

# --- Optional ---
CHAT_RATE_LIMIT_PER_MINUTE=20
